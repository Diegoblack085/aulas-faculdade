#include <stdio.h>

float n1;
float n2;
float n3;
float cal_nota (float n1, float n2, float n3)
{
    return (n1+n2+n3)/3;
}
int main(){
    printf("Diite a primeira nota\n ");
    scanf("%f", &n1);
   printf("Diite a segunda nota:\n");
    scanf("%f", &n2);
    printf("Diite a terceira nota:\n");
    scanf("%f", &n3);
    printf("A média é: %3.f\n", cal_nota(n1,n2,n3));
 
}
